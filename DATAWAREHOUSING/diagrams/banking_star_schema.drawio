        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    DIM_DATE ||--o{ FACT_TRANSACTION : transaction_date\n    DIM_ACCOUNT ||--o{ FACT_TRANSACTION : origin_account\n    DIM_ACCOUNT ||--o{ FACT_TRANSACTION : destination_account\n    DIM_TRANSACTION_TYPE ||--o{ FACT_TRANSACTION : transaction_type\n    DIM_BRANCH ||--o{ FACT_TRANSACTION : branch\n\n    DIM_ACCOUNT ||--o{ FACT_LOAN : account\n    DIM_LOAN_STATUS ||--o{ FACT_LOAN : loan_status\n    DIM_DATE ||--o{ FACT_LOAN : start_date\n    DIM_DATE ||--o{ FACT_LOAN : estimated_end_date\n\n    DIM_CUSTOMER {\n        bigint customer_key PK\n        int customer_id\n        string first_name\n        string last_name\n        date date_of_birth\n        string customer_type\n        date effective_date\n        date end_date\n        boolean is_current\n    }\n\n    DIM_ACCOUNT {\n        bigint account_key PK\n        int account_id\n        int customer_id\n        string account_type\n        string account_status\n        decimal balance\n        date opening_date\n    }\n\n    DIM_DATE {\n        int date_key PK\n        date full_date\n    }\n\n    DIM_BRANCH {\n        bigint branch_key PK\n        int branch_id\n    }\n\n    DIM_TRANSACTION_TYPE {\n        bigint transaction_type_key PK\n        int transaction_type_id\n    }\n\n    DIM_LOAN_STATUS {\n        bigint loan_status_key PK\n        int loan_status_id\n    }\n\n    FACT_TRANSACTION {\n        bigint transaction_key PK\n        int transaction_id\n        int date_key FK\n        bigint origin_account_key FK\n        bigint destination_account_key FK\n        bigint transaction_type_key FK\n        bigint branch_key FK\n        decimal amount\n    }\n\n    FACT_LOAN {\n        bigint loan_key PK\n        int loan_id\n        bigint account_key FK\n        bigint loan_status_key FK\n        int start_date_key FK\n        int estimated_end_date_key FK\n        decimal principal_amount\n        decimal interest_rate\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="VkgWTpiQPCos3ftqDo2p-1">
